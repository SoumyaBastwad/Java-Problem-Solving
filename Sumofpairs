package Demo;
import java.util.Scanner;

public class Sumofpairs {

	public static void main(String[] args) {
	    Scanner	sc=new Scanner(System.in);
           int a=sc.nextInt();
           int b=sc.nextInt();
           int c=sc.nextInt();
           int sum1=a+b;
           int sum2=a+c;
           int sum3=b+c;
           System.out.println(sum1);
           System.out.println(sum2);
           System.out.println(sum3);
	}

}

